<IfModule mod_mime.c>
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/svg+xml .svg
    AddType text/css .css
    AddType application/javascript .js
</IfModule>
<IfModule mod_headers.c>
    <Files "layout.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
    <Files "release.html">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
    <FilesMatch "\\.(png|jpg|jpeg|gif|webp|svg)$">
        Header unset Content-Disposition
    </FilesMatch>
</IfModule>
RewriteEngine On
RewriteRule ^(.+)/sitemap\\.xml/?$ /sitemap.xml [NC,L]
RewriteCond %{THE_REQUEST} \\s/+release\\.html(?:[\\s?]|$) [NC]
RewriteRule ^release\\.html$ /release [R=301,L,NC]
RewriteRule ^(features|feature)/?$ /syntax/ [R=301,L,NC]
RewriteRule ^(compare|comparison)/?$ /speed/ [R=301,L,NC]
RewriteRule ^developer/?$ /github/ [R=301,L,NC]
RewriteRule ^games/?$ / [R=301,L,NC]
RewriteRule ^VIB/?$ /VIB.html [NC,L]
RewriteRule ^docs\\.html$ /docs/ [R=301,L,NC]
RewriteRule ^(docs|documentation|doc)/?$ /vayu-documentation.html [NC,L]
RewriteRule ^(vcb|compiler)/?$ /VIB/ [R=301,L,NC]
RewriteRule ^release/?$ /release.html [NC,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\\.]+?)/?$ /$1.html [NC,L]
