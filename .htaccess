<IfModule mod_mime.c>
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/svg+xml .svg
    AddType text/css .css
    AddType application/javascript .js
</IfModule>

<IfModule mod_headers.c>\n    # Keep shared navigation and release data fresh after deployment.\n    <Files "layout.js">\n        Header set Cache-Control "no-cache, no-store, must-revalidate"\n    </Files>\n    <Files "release.html">\n        Header set Cache-Control "no-cache, no-store, must-revalidate"\n    </Files>
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg)$">
        Header unset Content-Disposition
    </FilesMatch>
</IfModule>

RewriteEngine On

# Allow the sitemap from the root and from any page path.
RewriteRule ^(.+)/sitemap\.xml/?$ /sitemap.xml [NC,L]

# Don't rewrite real files or folders
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Clean routes work with or without a trailing slash.
RewriteRule ^VIB/?$ /VIB.html [NC,L]
RewriteRule ^docs\.html$ /docs/ [R=301,L,NC]
RewriteRule ^(docs|documentation|doc)/?$ /vayu-documentation.html [NC,L]
RewriteRule ^(vcb|compiler)/?$ /VIB/ [R=301,L,NC]
RewriteRule ^([^\.]+?)/?$ /$1.html [NC,L]
